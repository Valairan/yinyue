<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>Yinyue</AssemblyName>
    <RootNamespace>Yinyue</RootNamespace>

    <ApplicationTitle>Yinyue</ApplicationTitle>
    <ApplicationId>com.yinyue.player</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>

    <!--
      Menu-bar only: no Dock icon, no app switcher entry. The AppKit equivalent of the
      Windows app's ShowInTaskbar="False" plus its tray icon, and the reason requirement 1
      ("summon overlay, not a window") holds here too. Set in Info.plist as LSUIElement.
    -->
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Hand-written rather than generated, because LSUIElement is not something the SDK
      properties can express and it is the key that makes this a menu-bar app at all.
    -->
    <None Include="Info.plist" LogicalName="Info.plist" />

    <!--
      Brand assets, generated from the shared masters by Common/make-mac-assets.sh. Copied
      into Resources/ where NSImage.ImageNamed and CFBundleIconFile both look.
    -->
    <BundleResource Include="..\Assets\menubar.png" Link="Resources\menubar.png" />
    <BundleResource Include="..\Assets\menubar@2x.png" Link="Resources\menubar@2x.png" />
    <BundleResource Include="..\Assets\Yinyue.icns" Link="Resources\Yinyue.icns" />

    <!-- Album-art fallback, the same asset the Windows app uses. -->
    <BundleResource Include="..\Assets\placeholder.png" Link="Resources\placeholder.png" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The platform-neutral half. Everything below the window — the queue, play order,
      shuffle, loop, retry, prebuffer, the Jellyfin client, the library, search and
      persistence — comes from here unmodified and is the same code the Windows app runs.
    -->
    <ProjectReference Include="..\..\core\Yinyue.Core\Yinyue.Core.csproj" />
  </ItemGroup>

</Project>
