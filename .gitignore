.claude/settings.local.json

# .NET build output for the macOS shell
mac/**/bin/
mac/**/obj/

# MSBuild SDK-resolver backups left behind when an IDE without the macos workload loads the Mac project
*.SdkResolver.*.proj.Backup.tmp

# The MSI is built on Windows and copied in when the site is assembled; it is not committed.
website/downloads/*.msi

# The DMGs are committed, so the macOS downloads work from a clone. One per architecture:
# 43 MB and 45 MB, against a repository that was 7 MB. Git keeps blobs forever, so every
# future version adds its own pair and a change of mind means rewriting history.
!website/downloads/*.dmg
installer/obj/
