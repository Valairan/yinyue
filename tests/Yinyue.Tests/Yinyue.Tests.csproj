<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      The suite constructs real windows and registers real hotkeys, so it needs WPF, the
      WinForms types the app pulls in, and an STA thread.
    -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>Yinyue.Tests</AssemblyName>
    <RootNamespace>Yinyue.Tests</RootNamespace>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\win\Yinyue.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The harness and the fakes, shared with tests/Yinyue.Core.Tests as linked source rather
      than through a project reference — the two runners are separate executables and should
      not know about each other.
    -->
    <Compile Include="..\Shared\Check.cs" Link="Check.cs" />
    <Compile Include="..\Shared\Fakes.cs" Link="Fakes.cs" />
  </ItemGroup>

</Project>
