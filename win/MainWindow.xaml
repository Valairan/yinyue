<Window x:Class="Yinyue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Yinyue.Controls"
        Title="Yinyue"
        Width="{StaticResource PanelWidth}"
        Height="{StaticResource PanelHeight}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!--
            The small text button in the queue panel ("Clear queue"). This was the header
            icon style until the icons were sized to match the transport row; see
            HeaderBtnStyle below.
        -->
        <Style x:Key="SmallTextBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MediaBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="4,0"/>
            <!--
                A button must not resize when its icon changes, or the whole centred row
                reflows and every button appears to jump. With text glyphs that was a live
                problem — the play triangle measured 20.9px against 28.6px for every other
                glyph. Icons are a fixed 24-unit box, so this is now a guard rather than a
                fix, and it also keeps the row's spacing where it was.
            -->
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="4" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            The header icons — queue, offline, favourites, settings — are the transport style
            with a hover background added, so the four icons above the title measure exactly
            what the six below the seek bar do. They used to be a 24×22 box at 13px against
            the transport row's 30-wide 15px glyphs, and the mismatch read as two different
            sets of controls. No horizontal margin: the header shares its row with the status
            line, which needs the room.
        -->
        <Style x:Key="HeaderBtnStyle" TargetType="Button" BasedOn="{StaticResource MediaBtnStyle}">
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!--
        AllowsTransparency is back on because WPF refuses to layer a window without it, and
        an unlayered window ignores Opacity entirely — so the show/hide fade would be a pop.
        Verified: SetWindowLong silently drops WS_EX_LAYERED and SetLayeredWindowAttributes
        fails with error 87. The cost is the software-composited path for a 420px panel that
        is hidden most of the time, which is the better side of that trade. It also restores
        real per-pixel rounded corners, so the radius lives here rather than coming from DWM.
    -->
    <Border x:Name="RootBorder"
            Background="{StaticResource BaseBrush}"
            BorderBrush="{StaticResource Surface0Brush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--
                Album artwork: a square centred in its column, not a box the full height of
                the panel. The column is 130 wide and the content 148 tall, and UniformToFill
                into a frame that tall scaled the art to 148 and clipped the excess off the
                right edge only, so the mark sat visibly left of centre. Measured by rendering:
                the image element was 148 wide from the frame's left edge. A square frame has
                nothing to clip for square art, and the image is centre-aligned so non-square
                art clips evenly on both sides rather than on one.
            -->
            <Border x:Name="ArtFrame"
                    Grid.Column="0"
                    Width="130"
                    Height="130"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                    ClipToBounds="True"
                    Background="{StaticResource MantleBrush}">
                <Image x:Name="ImgAlbumArt"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="pack://application:,,,/Yinyue;component/Resources/placeholder.png"/>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--
                    Row 0: status/search on the left, header buttons on the right.
                    The buttons are ALWAYS visible. They used to be collapsed while
                    searching, which hid the settings cog — and since the overlay opens
                    into search when nothing is playing, that made settings unreachable
                    on a fresh install, so no library could ever be added.
                -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!--
                        The status line has this cell to itself now. The search box moved out
                        to its own row above the applet, so the two no longer take turns and
                        the status stays readable while searching.
                    -->
                    <TextBlock x:Name="TxtStatus"
                               Grid.Column="0"
                               Margin="0,0,6,0"
                               Text="Yinyue"
                               Foreground="{StaticResource SubtextBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <StackPanel x:Name="HeaderButtonsPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!--
                            Only on screen while the timer runs. It lives here rather than on
                            the status line because that line carries transient messages and
                            would keep overwriting it.
                        -->
                        <ui:Icon x:Name="IcoSleep"
                                 Kind="Moon"
                                 Size="12"
                                 Visibility="Collapsed"
                                 Foreground="{StaticResource WarningBrush}"
                                 Margin="0,0,4,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSleepRemaining"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="11"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnBurgerMenu"
                                Style="{StaticResource HeaderBtnStyle}"
                                ToolTip="Queue"
                                Click="BtnBurgerMenu_Click">
                            <ui:Icon x:Name="IcoQueue" Kind="List"/>
                        </Button>
                        <Button x:Name="BtnOfflineToggle"
                                Style="{StaticResource HeaderBtnStyle}"
                                ToolTip="Offline mode"
                                Click="BtnOfflineToggle_Click">
                            <ui:Icon x:Name="IcoOffline" Kind="Cloud"/>
                        </Button>
                        <Button x:Name="BtnShuffleFavorites"
                                Style="{StaticResource HeaderBtnStyle}"
                                ToolTip="Shuffle all favourites"
                                Click="BtnShuffleFavorites_Click">
                            <ui:Icon x:Name="IcoShuffleFavorites" Kind="HeartShuffle"/>
                        </Button>
                        <Button x:Name="BtnSettingsGear"
                                Style="{StaticResource HeaderBtnStyle}"
                                ToolTip="Settings"
                                Click="BtnSettingsGear_Click">
                            <ui:Icon x:Name="IcoSettings" Kind="Cog"/>
                        </Button>
                    </StackPanel>

                    <!-- Queue: what is actually coming next, in play order -->
                    <!--
                        Both panels are placed against RootBorder rather than the control that
                        opens them, so they line up with the applet edge for edge instead of
                        floating off whichever button was pressed. Placement=Top puts the
                        panel's bottom on the applet's top; the stack order above that is
                        arranged by VerticalOffset in UpdatePanelStack.
                    -->
                    <Popup x:Name="QueuePopup"
                           AllowsTransparency="True"
                           PlacementTarget="{Binding ElementName=RootBorder}"
                           Placement="Relative"
                           StaysOpen="False"
                           IsOpen="False"
                           Width="{StaticResource PanelWidth}">
                        <Border x:Name="QueuePanel"
                                Background="{StaticResource BaseBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <StackPanel>
                                <Grid Margin="4,2,4,4">
                                    <TextBlock x:Name="TxtQueueHeader"
                                               Text="Queue"
                                               Foreground="{StaticResource SubtextBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtQueueHint"
                                               Text="Enter plays · Del removes · hold to clear"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource Surface2Brush}"
                                               FontSize="9"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <ListBox x:Name="LstQueue"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource TextBrush}"
                                         MaxHeight="200"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         MouseDoubleClick="LstQueue_MouseDoubleClick"
                                         PreviewKeyDown="LstQueue_PreviewKeyDown">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!--
                                                A grabbed row grows and gains an accent rule,
                                                so "this is the thing the arrows now move" is
                                                readable without a caption.
                                            -->
                                            <Border x:Name="Row"
                                                    Padding="0"
                                                    BorderThickness="0"
                                                    CornerRadius="3">
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ui:Icon x:Name="RowMarker"
                                                         Grid.Column="0"
                                                         Kind="{Binding MarkerKind}"
                                                         Size="10"
                                                         Filled="True"
                                                         Foreground="{StaticResource AccentBrush}"
                                                         VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" Orientation="Vertical">
                                                    <TextBlock x:Name="RowTitle"
                                                               Text="{Binding Track.Title}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="RowArtist"
                                                               Text="{Binding Track.DisplayArtist}"
                                                               Foreground="{StaticResource SubtextBrush}"
                                                               FontSize="9"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DurationText}"
                                                           Foreground="{StaticResource Surface2Brush}"
                                                           FontSize="9"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,2,0"/>
                                            </Grid>
                                            </Border>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsGrabbed}" Value="True">
                                                    <Setter TargetName="Row" Property="Background"
                                                            Value="{StaticResource Surface0Brush}"/>
                                                    <Setter TargetName="Row" Property="BorderThickness" Value="2,0,0,0"/>
                                                    <Setter TargetName="Row" Property="BorderBrush"
                                                            Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="Row" Property="Padding" Value="4,3"/>
                                                    <Setter TargetName="RowTitle" Property="FontSize" Value="14"/>
                                                    <Setter TargetName="RowTitle" Property="FontWeight" Value="SemiBold"/>
                                                    <Setter TargetName="RowArtist" Property="FontSize" Value="11"/>
                                                    <Setter TargetName="RowMarker" Property="Kind" Value="MoveVertical"/>
                                                    <Setter TargetName="RowMarker" Property="Filled" Value="False"/>
                                                    <Setter TargetName="RowMarker" Property="Size" Value="12"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="TxtQueueEmpty"
                                           Text="Nothing queued yet. Search for something to play."
                                           Visibility="Collapsed"
                                           Foreground="{StaticResource SubtextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="4,3"/>

                                <Button x:Name="BtnClearQueue"
                                        Content="Clear queue"
                                        Style="{StaticResource SmallTextBtnStyle}"
                                        Width="Auto"
                                        Height="Auto"
                                        Padding="6,3"
                                        FontSize="10"
                                        HorizontalAlignment="Left"
                                        Margin="2,4,0,0"
                                        Foreground="{StaticResource SubtextBrush}"
                                        Click="BtnClearQueue_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!--
                        The search box sits in its own row, open for as long as the overlay
                        is. Nothing to summon and nothing that takes the status line away:
                        the box is simply there, and typing anywhere in the overlay lands in
                        it. Results stack above this row, the queue above those.
                    -->
                    <Popup x:Name="SearchBarPopup"
                           AllowsTransparency="True"
                           PlacementTarget="{Binding ElementName=RootBorder}"
                           Placement="Relative"
                           StaysOpen="True"
                           IsOpen="False"
                           Width="{StaticResource PanelWidth}">
                        <Border x:Name="SearchBarPanel"
                                Background="{StaticResource BaseBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ui:Icon Grid.Column="0"
                                         Kind="Search"
                                         Size="14"
                                         Margin="2,0,8,0"
                                         Foreground="{StaticResource SubtextBrush}"
                                         VerticalAlignment="Center"/>

                                <Grid Grid.Column="1">
                                    <TextBox x:Name="SearchTextBox"
                                             Background="Transparent"
                                             Foreground="{StaticResource TextBrush}"
                                             CaretBrush="{StaticResource TextBrush}"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontSize="13"
                                             VerticalAlignment="Center"
                                             PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>

                                    <!--
                                        WPF has no placeholder, so this sits behind the box
                                        and hides as soon as anything is typed. It carries the
                                        prefixes because there is nowhere else they would ever
                                        be found: the search box is the only place they work,
                                        and the only place anyone looks.
                                    -->
                                    <TextBlock x:Name="TxtSearchPlaceholder"
                                               IsHitTestVisible="False"
                                               Text="Search…  try  album:  fav:  queue:"
                                               Foreground="{StaticResource Surface2Brush}"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Popup>

                    <Popup x:Name="SearchPopup"
                           AllowsTransparency="True"
                           PlacementTarget="{Binding ElementName=RootBorder}"
                           Placement="Relative"
                           StaysOpen="False"
                           IsOpen="False"
                           Width="{StaticResource PanelWidth}">
                        <Border x:Name="SearchPanel"
                                Background="{StaticResource BaseBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <StackPanel>
                                <!-- Carries "no matches" and configuration hints, which
                                     would otherwise be invisible while the search box
                                     occupies the status line. -->
                                <TextBlock x:Name="TxtSearchMessage"
                                           Visibility="Collapsed"
                                           Foreground="{StaticResource SubtextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="4,3"/>

                                <ListBox x:Name="LstSearchResults"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource TextBrush}"
                                         MaxHeight="200"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="LstSearchResults_SelectionChanged"
                                         MouseDoubleClick="LstSearchResults_MouseDoubleClick"
                                         PreviewKeyDown="LstSearchResults_PreviewKeyDown">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontWeight="Bold"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <!-- Artist AND album: the artist alone leaves
                                                         a third of results indistinguishable. -->
                                                    <TextBlock Text="{Binding SearchSubtitle}"
                                                               Foreground="{StaticResource SubtextBrush}"
                                                               FontSize="9"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="6,0,2,0">
                                                    <TextBlock Text="{Binding DurationText}"
                                                               Foreground="{StaticResource SubtextBrush}"
                                                               FontSize="9"
                                                               HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding Source}"
                                                               Foreground="{StaticResource Surface2Brush}"
                                                               FontSize="8"
                                                               HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Row 1: Track Metadata -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,2">
                    <TextBlock x:Name="TxtSongTitle"
                               Text="No Track Selected"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="Bold"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtArtistName"
                               Text="Unknown Artist"
                               Foreground="{StaticResource SubtextBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Row 2: Progress Slider & Timestamp -->
                <Grid Grid.Row="2" Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtCurrentTime"
                               Text="00:00"
                               Foreground="{StaticResource SubtextBrush}"
                               FontSize="10"
                               Grid.Column="0"/>
                    <Slider x:Name="SliderProgress"
                            Grid.Column="1"
                            Margin="6,0"
                            VerticalAlignment="Center"
                            Height="12"
                            Minimum="0"
                            Maximum="100"
                            ValueChanged="SliderProgress_ValueChanged"/>
                    <TextBlock x:Name="TxtTotalTime"
                               Text="00:00"
                               Foreground="{StaticResource SubtextBrush}"
                               FontSize="10"
                               Grid.Column="2"/>
                </Grid>

                <!-- Row 3: Bottom Control Bar -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0">
                    <Button x:Name="BtnPrevious"
                            Style="{StaticResource MediaBtnStyle}"
                            ToolTip="Previous">
                        <ui:Icon x:Name="IcoPrevious" Kind="SkipBack"/>
                    </Button>
                    <Button x:Name="BtnPlayPause"
                            Style="{StaticResource MediaBtnStyle}"
                            ToolTip="Play / Pause">
                        <ui:Icon x:Name="IcoPlayPause" Kind="Play"/>
                    </Button>
                    <Button x:Name="BtnNext"
                            Style="{StaticResource MediaBtnStyle}"
                            ToolTip="Next">
                        <ui:Icon x:Name="IcoNext" Kind="SkipForward"/>
                    </Button>
                    <Button x:Name="BtnShuffle"
                            Style="{StaticResource MediaBtnStyle}"
                            Margin="12,0,4,0"
                            ToolTip="Shuffle off">
                        <ui:Icon x:Name="IcoShuffle" Kind="Shuffle"/>
                    </Button>
                    <Button x:Name="BtnLoop"
                            Style="{StaticResource MediaBtnStyle}"
                            ToolTip="Loop off">
                        <ui:Icon x:Name="IcoLoop" Kind="RepeatOff"/>
                    </Button>
                    <!--
                        heart-plus until the track is a favourite, then a filled heart. The
                        header's shuffle-favourites button carries the heart-shuffle mark, so
                        the two hearts do two visibly different jobs.
                    -->
                    <Button x:Name="BtnFavorite"
                            Style="{StaticResource MediaBtnStyle}"
                            ToolTip="Toggle Favorite">
                        <ui:Icon x:Name="IcoFavorite" Kind="HeartPlus"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
